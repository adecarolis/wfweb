# The build id: what tells a development build from a release.
# Included by wfweb.pro and launcher/launcher.pro.
#
# wfweb_build.h (WFWEB_BUILD_ID, WFWEB_BUILD_GIT) is generated in the build
# directory and included by src/buildinfo.cpp alone, so a new commit
# recompiles that one file. It is a header and not a -D flag for the reason
# given in include/wfweb_version.h: Make does not rerun a compile because a
# flag changed. The rules are in tools/build-id.sh.

INCLUDEPATH += $$OUT_PWD
SOURCES += $$PWD/src/buildinfo.cpp
HEADERS += $$PWD/include/buildinfo.h
QMAKE_DISTCLEAN += wfweb_build.h

!win32 {
    BUILD_ID_SCRIPT = $$shell_quote($$PWD/tools/build-id.sh)

    # Now, so that qmake's dependency scan finds the header...
    !system($$BUILD_ID_SCRIPT --header $$shell_quote($$OUT_PWD/wfweb_build.h)): \
        error("tools/build-id.sh failed")

    # ...and again on every make: the script leaves the file alone when the
    # id has not changed, so nothing is rebuilt then.
    buildid.target = wfweb_build.h
    buildid.depends = FORCE
    buildid.commands = $$BUILD_ID_SCRIPT --header wfweb_build.h
    QMAKE_EXTRA_TARGETS += buildid
}

# No shell under nmake: the same rules in qmake, applied when qmake runs
# (build.bat and CI always run it).
win32 {
    BUILD_ID_LINES = $$cat($$PWD/include/wfweb_version.h, lines)
    BUILD_ID_LINE  = $$find(BUILD_ID_LINES, "define WFWEB_VERSION ")
    BUILD_ID_BASE  = $$replace(BUILD_ID_LINE, "[^0-9.]", "")

    BUILD_ID  = $$(WFWEB_BUILD_ID)
    BUILD_GIT = $$system(git -C $$shell_quote($$PWD) rev-parse --short HEAD 2>NUL)
    isEmpty(BUILD_ID):!isEmpty(BUILD_GIT) {
        BUILD_ID_TAGS = $$system(git -C $$shell_quote($$PWD) tag --points-at HEAD 2>NUL)
        !contains(BUILD_ID_TAGS, v$$BUILD_ID_BASE): BUILD_ID = dev.$$BUILD_GIT
    }
    equals(BUILD_ID, release): BUILD_ID =

    BUILD_ID_HEADER = \
        "// Generated by buildid.pri when qmake runs. Do not edit, do not commit." \
        "$${LITERAL_HASH}define WFWEB_BUILD_ID \"$$BUILD_ID\"" \
        "$${LITERAL_HASH}define WFWEB_BUILD_GIT \"$$BUILD_GIT\""
    !write_file($$OUT_PWD/wfweb_build.h, BUILD_ID_HEADER): \
        error("could not write wfweb_build.h")
}
