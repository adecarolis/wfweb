[Unit]
Description=wfweb — browser-based remote control for amateur radio
# Without PipeWire's device list wfweb falls back to the raw hw: device, which
# locks every other program out of the rig's USB CODEC.
Wants=pipewire-pulse.service wireplumber.service
After=pipewire-pulse.service wireplumber.service

[Service]
Type=simple
Restart=on-failure
RestartSec=5
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=/usr/local/bin/wfweb

[Install]
WantedBy=default.target
